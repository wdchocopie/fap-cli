# Sao chép file này thành .env rồi điền. KHÔNG commit file .env.
# Copy this to .env and fill in. DO NOT commit .env.

# Ngôn ngữ thông báo/log: vi | en
FAP_LANG=vi

# Học kỳ — để trống = tự dò qua GetSemester. Ép: vd Spring2026
FAP_SEMESTER=

# Telegram (BotFather cho TOKEN; CHAT = id chat/kênh)
TELEGRAM_TOKEN=
TELEGRAM_CHAT=

# Discord (Server Settings → Integrations → Webhooks → New Webhook → Copy URL)
DISCORD_WEBHOOK_URL=

# Google Calendar (primary = lịch chính). Cần credentials.json + chạy `fap calendar-auth`
GCAL_CALENDAR_ID=primary

# --- Bot tương tác (fap telegram-bot / fap discord-bot) ---
# Telegram bot: dùng lại TELEGRAM_TOKEN + TELEGRAM_CHAT ở trên (TELEGRAM_CHAT BẮT BUỘC để khóa bot).
# Discord bot: token bot (KHÁC webhook URL) + id user của bạn để chỉ trả lời bạn.
# DISCORD_ALLOWED_USER_ID BẮT BUỘC; muốn mở bot cho mọi người thì đặt DISCORD_ALLOW_ANYONE=1.
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_ID=
# DISCORD_ALLOW_ANYONE=1   # (NGUY HIỂM) cho phép chạy discord-bot khi KHÔNG đặt ALLOWED_USER_ID
# Nhắc trước mỗi tiết: số PHÚT trước giờ vào lớp bot tự nhắc (mặc định 30, mỗi tiết 1 lần). 0 = tắt.
FAP_REMIND_MINUTES=

# Tự cập nhật KHI ĐANG CHẠY (bot/watcher thường trú): số PHÚT giữa mỗi lần dò `git pull`.
# 0/trống = TẮT (mặc định). Khi >0: tiến trình nền tự pull -> selftest -> nếu PASS thì tự khởi động lại.
# (Bot còn có lệnh /update thủ công dù bật hay tắt.) Ví dụ 180 = dò mỗi 3 giờ.
FAP_AUTOUPDATE_MIN=

# --- Theo dõi điểm danh (fap watch-attendance) ---
# 1 = CHỈ báo buổi vắng/muộn (đỡ spam "Có mặt"). Để trống = báo mọi buổi mới.
FAP_WATCH_ABSENT_ONLY=

# --- Cache (máy yếu / lịch sự với server) ---
# Số PHÚT cache phản hồi API trong bộ nhớ (giảm gọi lại endpoint giống nhau). 0/trống = tắt.
# Hữu ích cho `fap web` (chạy nền) và `fap status`. Đặt nhỏ (vd 5) để dữ liệu không quá cũ.
FAP_CACHE_MIN=

# --- Trích xuất (fap extract) ---
# Giây nghỉ giữa mỗi lượt gọi API khi `fap extract` (lịch sự với server). Mặc định 0.7.
FAP_EXTRACT_DELAY=

# --- Nhiều tài khoản trên CÙNG 1 máy (multi-profile) ---
# Tên profile đang chạy. Để TRỐNG = chế độ 1 tài khoản như cũ (không cần đổi gì).
# Chỉ dùng chữ/số/dấu . _ - (vd: alice). Tên sai định dạng bị bỏ qua = coi như để trống.
# Đặt FAP_PROFILE=alice thì:
#   - trạng thái/token nằm ở output/profiles/alice/  (không đè lên tài khoản khác)
#   - cấu hình đọc từ .env.alice ở gốc repo TRƯỚC, rồi .env này chỉ bù các khóa KHÔNG mang danh tính
#   - các khóa gửi/danh tính (TELEGRAM_TOKEN, TELEGRAM_CHAT, DISCORD_WEBHOOK_URL, DISCORD_BOT_TOKEN,
#     DISCORD_ALLOWED_USER_ID, DISCORD_ALLOW_ANYONE, GCAL_CALENDAR_ID, FAP_ALLOW_UPDATE) KHÔNG được
#     thừa kế từ file này. Profile không tự khai -> kênh đó TẮT (đúng ý: không bắn vào chat chủ máy).
# => .env.alice phải chứa ĐẦY ĐỦ TELEGRAM_*/DISCORD_* của alice. Nhớ gitignore file .env.<profile>.
# Mỗi profile chạy 1 tiến trình/systemd unit riêng (đặt biến trong unit, đừng đặt ở đây).
FAP_PROFILE=

# --- Dùng CHUNG 1 session cho 2 máy (vd: VPS chạy bot + PC chỉ xem) ---
# 1 = CẤM refresh token trên máy này (mọi lệnh chỉ đọc; hết hạn thì báo lỗi rõ, không tự xoay token).
# refresh_token XOAY VÒNG: máy nào refresh trước thì token của máy kia thành vô hiệu.
# ĐẶT TRÊN MÁY PHỤ (cái PC copy token.json về) — TUYỆT ĐỐI KHÔNG đặt trên máy chạy
# watcher/bot (máy SỞ HỮU việc refresh); đặt nhầm ở đó thì watcher sẽ ngừng refresh và chết lặng.
# Để trống = máy này được refresh (mặc định).
FAP_TOKEN_READONLY=

# --- Quyền chạy lệnh bot /update ---
# 1 = cho phép /update (`git pull` + selftest + tự khởi động lại). Để trống = CẤM (mặc định).
# /update tác động lên checkout DÙNG CHUNG của MỌI profile, nên chỉ bật trong unit của CHỦ MÁY;
# đừng bật trong .env.<profile> của khách.
FAP_ALLOW_UPDATE=
